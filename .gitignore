# runs are evidence with their own git repo each; inbox holds incoming files
runs/*
!runs/.gitkeep
inbox/*
!inbox/.gitkeep
# large, rebuildable by setup/
toolchain/python/
toolchain/models/
toolchain/bin/
__pycache__/
*.pyc
*.tmp
evals/runs/
# truth vs output per turn: holds the words of the fixtures (private recordings): this PC only
evals/compare/
setup/logs/
toolchain/downloads/
# training data slices (setup/make_indicvoices_slice.py): large, rebuildable; on this PC they live on the USB (junctions)
toolchain/data/
toolchain/*.log
# private recordings and their transcripts stay on this PC only (never pushed)
evals/fixtures/*/
# the owner's test recordings (no transcripts yet; they become fixtures once corrected): this PC only
evals/test_audio/
