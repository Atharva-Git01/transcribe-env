{
  "title": "trx plan: the exact steps and parameters for one run (the ONLY source of params for stages)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "env_version", "run_id", "created_utc", "recipe", "selected_by", "overrides", "output", "stages"],
  "properties": {
    "schema": {"const": "trx.plan/1"},
    "env_version": {"type": "string"},
    "run_id": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string"},
    "recipe": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "file"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "integer"},
        "file": {"type": "string"}
      }
    },
    "selected_by": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "reason", "forced"],
      "properties": {
        "rule_id": {"type": "string"},
        "reason": {"type": "string"},
        "forced": {"type": "boolean"}
      }
    },
    "overrides": {"type": "object"},
    "output": {"type": "object"},
    "stages": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "status", "available_from_phase", "params"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["pending", "done", "skipped", "not_installed", "failed"]},
          "available_from_phase": {"type": "integer"},
          "params": {"type": "object"}
        }
      }
    }
  }
}
